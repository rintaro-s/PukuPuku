using Gtk 4.0;
using Adw 1;

template $CharacterStatusWidget : Adw.Bin {
  child: Adw.Clamp {
    maximum-size: 1000;

    child: Box {
      margin-top: 2;
      margin-bottom: 2;
      margin-start: 4;
      margin-end: 4;
      spacing: 6;

      Image character_picture {
        styles ["character-paper"]
        pixel-size: 96;
        halign: start;
        valign: start;
      }

      Box {
        orientation: vertical;
        spacing: 0;
        hexpand: true;

        Label title_label {
          styles ["heading"]
          label: _("Status");
          halign: start;
        }

        Label mood_label {
          label: "-";
          halign: start;
          wrap: true;
        }
      }
    };
  };
}
